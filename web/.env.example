# Supabase project URL and anon key: Project Settings -> API, or the Connect
# dialog. Both are NEXT_PUBLIC_ because the browser needs them, which is the
# whole reason 0003_enable_rls.sql exists: this key can only ever read.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Where a visitor's postal-code area is looked up for "Stores near me".
# Server-side only, so no NEXT_PUBLIC_ prefix. Any service that answers
# <url><FSA> in zippopotam.us's shape works; the default is below.
# Only the first three characters of a postal code are ever sent.
# POSTAL_GEOCODER_URL=https://api.zippopotam.us/ca/

# Optional. The site's public address, for link previews, robots.txt and the
# sitemap. Only needed for a custom domain: on Vercel the production domain is
# used without it, and locally http://localhost:3000.
# SITE_URL=https://loonie.example.com
