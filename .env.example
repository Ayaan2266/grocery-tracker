# Loblaw PCX API. Static public key shipped in the storefront bundle.
# Not a credential, but keep it out of git anyway.
PCX_API_KEY=

# Supabase Postgres connection string (use the pooler URI, port 6543).
# ingest/db.py connects with prepare_threshold=None because transaction-mode
# pooling and server-side prepared statements do not mix.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Seconds between outbound requests. Do not lower this.
INGEST_RATE_LIMIT_SECONDS=1.0
